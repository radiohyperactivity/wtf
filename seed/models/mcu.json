{
  "format": "wtf-model",
  "version": 2,
  "meta": {
    "name": "Microcontrollers",
    "description": "MCUs by family, with what tells them apart: clock, memory, pins, timers and package."
  },
  "classes": [
    {
      "name": "MCU",
      "container": true,
      "attributes": {
        "Core": { "scope": "item", "type": "choice", "required": true, "order": 1,
                  "choices": ["AVR", "Cortex-M0", "Cortex-M0+", "Cortex-M3", "Cortex-M4", "Cortex-M7", "RISC-V", "Xtensa"] },
        "Clock": { "scope": "item", "type": "decimal", "unit": "MHz", "required": true, "order": 2 },
        "Flash": { "scope": "item", "type": "integer", "unit": "KiB", "required": true, "order": 3 },
        "RAM": { "scope": "item", "type": "integer", "unit": "KiB", "order": 4 },
        "EEPROM": { "scope": "item", "type": "integer", "unit": "B", "order": 5 },
        "GPIO pins": { "scope": "item", "type": "integer", "order": 6 },
        "Timers": { "scope": "item", "type": "integer", "order": 7 },
        "ADC channels": { "scope": "item", "type": "integer", "order": 8 },
        "Supply voltage": { "scope": "item", "type": "decimal", "unit": "V", "order": 9 },
        "Package": { "scope": "item", "type": "choice", "order": 10,
                     "choices": ["DIP", "SOIC", "SSOP", "TQFP", "QFN", "BGA", "Module"] },
        "Datasheet": { "scope": "item", "type": "url", "order": 11 },
        "Programmed with": { "scope": "stock", "type": "text", "order": 1 }
      },
      "classes": [
        { "name": "AVR" },
        { "name": "ARM" },
        { "name": "ESP32" },
        { "name": "RP2040" }
      ]
    }
  ]
}
